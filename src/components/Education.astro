---
interface Props {
  id: string;
  education: {
    eyebrow: string;
    title: string;
    academicTitle: string;
    coursesTitle: string;
    academic: { period: string; degree: string; institution: string }[];
    courses: { institution: string; course: string }[];
  };
}
const { id, education } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{education.eyebrow}</span>
      <h2>{education.title}</h2>
    </div>

    <div class="edu-block" data-reveal>
      <h3>{education.academicTitle}</h3>
      {education.academic.map((a) => (
        <div class="edu-item">
          <span class="period">{a.period}</span>
          <p class="title">{a.degree}</p>
          <p class="inst">{a.institution}</p>
        </div>
      ))}
    </div>

    <div class="edu-block" data-reveal>
      <h3>{education.coursesTitle}</h3>
      {education.courses.map((c) => (
        <div class="edu-item">
          <p class="title">{c.course}</p>
          <p class="inst">{c.institution}</p>
        </div>
      ))}
    </div>
  </div>
</section>

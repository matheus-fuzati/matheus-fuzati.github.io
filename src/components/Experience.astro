---
interface Item {
  period: string;
  current?: boolean;
  role: string;
  company: string;
  companyNote?: string;
  description: string;
}
interface Props {
  id: string;
  experience: {
    eyebrow: string;
    title: string;
    footnote?: string;
    items: Item[];
  };
}
const { id, experience } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{experience.eyebrow}</span>
      <h2>{experience.title}</h2>
    </div>
    <div class="timeline">
      {experience.items.map((item) => (
        <div class="tl-item" data-reveal>
          <span class="period">
            {item.period}
            {item.current && <span class="badge">●</span>}
          </span>
          <p class="role">{item.role}</p>
          <p class="company">
            {item.company}
            {item.companyNote && <> — {item.companyNote}</>}
          </p>
          <p class="desc">{item.description}</p>
        </div>
      ))}
    </div>
    {experience.footnote && (
      <p style="margin-top:20px;font-size:12.5px;color:var(--muted);">{experience.footnote}</p>
    )}
  </div>
</section>

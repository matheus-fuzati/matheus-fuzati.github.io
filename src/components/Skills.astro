---
interface Props {
  id: string;
  skills: {
    eyebrow: string;
    title: string;
    categories: { title: string; items: string[] }[];
  };
}
const { id, skills } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{skills.eyebrow}</span>
      <h2>{skills.title}</h2>
    </div>
    <div class="skills-grid">
      {skills.categories.map((cat) => (
        <div class="skill-card" data-reveal>
          <h3>{cat.title}</h3>
          <ul>
            {cat.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

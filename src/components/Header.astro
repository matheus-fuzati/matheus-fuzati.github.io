---
interface Props {
  locale: "pt" | "en";
  nav: { href: string; label: string }[];
  brand: string;
}
const { locale, nav, brand } = Astro.props;
const ptHref = locale === "pt" ? "/" : "/";
const enHref = "/en/";
---

<header id="top" class="site-header">
  <div class="container bar">
    <a class="brand" href={locale === "pt" ? "/" : "/en/"}>{brand}</a>
    <nav>
      <ul class="nav-links">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="lang-toggle">
      <a href={ptHref} aria-current={locale === "pt" ? "true" : "false"}>PT</a>
      <span aria-hidden="true">·</span>
      <a href={enHref} aria-current={locale === "en" ? "true" : "false"}>EN</a>
    </div>
  </div>
</header>

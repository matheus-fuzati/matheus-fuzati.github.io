---
interface Props {
  id: string;
  projects: {
    eyebrow: string;
    title: string;
    emptyTitle: string;
    emptyBody: string;
    emptyCta: { label: string; href: string };
  };
}
const { id, projects } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{projects.eyebrow}</span>
      <h2>{projects.title}</h2>
    </div>
    <div class="projects-empty" data-reveal>
      <strong>{projects.emptyTitle}</strong>
      <p>{projects.emptyBody}</p>
      <div style="margin-top:20px;">
        <a class="btn btn-ghost" href={projects.emptyCta.href} target="_blank" rel="noopener">
          {projects.emptyCta.label}
        </a>
      </div>
    </div>
  </div>
</section>

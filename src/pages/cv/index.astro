---
import Base from "../../layouts/Base.astro";
import { content } from "../../data/content";

const d = content.pt;
---

<Base lang="pt" title="Currículo — Matheus Fuzati" description="Currículo de Matheus Fuzati, Engenheiro de Dados na DP6, alocado no Itaú.">
  <main class="container" style="max-width:820px;padding-top:56px;padding-bottom:80px;">
    <div class="no-print" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:32px;">
      <a href="/" style="font-family:var(--font-mono);font-size:13px;color:var(--muted);text-decoration:none;">← {d.cv.backCta}</a>
      <button class="btn btn-primary" onclick="window.print()">{d.cv.printCta}</button>
    </div>

    <header style="margin-bottom:40px;">
      <h1 style="font-size:34px;">{d.hero.name}</h1>
      <p style="color:var(--accent);font-family:var(--font-mono);font-size:14px;margin-top:6px;">
        {d.hero.eyebrow}
      </p>
      <p style="margin-top:14px;color:var(--muted);max-width:60ch;">{d.about.paragraphs[0]}</p>
      <div style="margin-top:16px;display:flex;flex-wrap:wrap;gap:16px;font-family:var(--font-mono);font-size:12.5px;color:var(--muted);">
        {d.contact.channels.filter((c) => c.k !== "WhatsApp").map((c) => (
          <a href={c.href} style="color:inherit;text-decoration:none;">{c.k}: {c.v}</a>
        ))}
      </div>
    </header>

    <section style="margin-bottom:36px;">
      <h2 style="font-family:var(--font-mono);font-size:14px;text-transform:uppercase;letter-spacing:.07em;color:var(--accent);margin-bottom:16px;">
        {d.experience.title}
      </h2>
      <div class="timeline">
        {d.experience.items.map((item) => (
          <div class="tl-item">
            <span class="period">{item.period}</span>
            <p class="role">{item.role}</p>
            <p class="company">{item.company}{item.companyNote ? ` — ${item.companyNote}` : ""}</p>
            <p class="desc">{item.description}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:12px;font-size:11.5px;color:var(--muted);">{d.experience.footnote}</p>
    </section>

    <section style="margin-bottom:36px;">
      <h2 style="font-family:var(--font-mono);font-size:14px;text-transform:uppercase;letter-spacing:.07em;color:var(--accent);margin-bottom:16px;">
        {d.skills.title}
      </h2>
      <div style="display:flex;flex-direction:column;gap:14px;">
        {d.skills.categories.map((cat) => (
          <div>
            <p style="font-family:var(--font-mono);font-size:12.5px;color:var(--text);margin-bottom:6px;">{cat.title}</p>
            <p style="color:var(--muted);font-size:14px;line-height:1.7;">{cat.items.join(" · ")}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 style="font-family:var(--font-mono);font-size:14px;text-transform:uppercase;letter-spacing:.07em;color:var(--accent);margin-bottom:16px;">
        {d.education.title}
      </h2>
      {d.education.academic.map((a) => (
        <div class="edu-item">
          <span class="period">{a.period}</span>
          <p class="title">{a.degree}</p>
          <p class="inst">{a.institution}</p>
        </div>
      ))}
    </section>
  </main>
</Base>
